# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values for local development.
# The app builds and the homepage renders with NONE of these set — the contact
# form falls back to a mailto link and the newsletter is hidden until the
# relevant services are configured.
# ---------------------------------------------------------------------------

# Neon (serverless Postgres) connection string, used by Drizzle.
# Use the POOLED connection string (the host contains "-pooler").
#
# Locally this should be a Neon BRANCH (e.g. local-dev), never the main branch
# that production uses — otherwise seeding writes straight into live data:
#   npx neonctl connection-string local-dev --project-id <project> --pooled
#
# Without it: the blog renders empty and enquiries/view counts are not stored.
DATABASE_URL=

# Resend API key for transactional email (https://resend.com).
# Without it (or CONTACT_FROM_EMAIL): no emails are sent and the newsletter is
# unavailable.
RESEND_API_KEY=

# Where contact-form notifications are delivered (your inbox).
CONTACT_TO_EMAIL=

# Verified Resend sender, e.g. "Robert Njonjo <hello@yourdomain.com>".
# Must be on a domain you've verified in Resend.
CONTACT_FROM_EMAIL=

# Secret salt used to hash client IPs before they touch the database.
# Set any long random string. Raw IPs are never stored.
IP_HASH_SALT=

# Public canonical origin, no trailing slash, e.g. https://robertnjonjo.com
# Used for metadata, canonical URLs, sitemap, RSS and OG image URLs.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# STUDIO — the private writing interface at /studio
# ---------------------------------------------------------------------------

# Password for signing in to /studio. Choose a long, unique one.
# If this or SESSION_SECRET is missing, /studio returns 404 — a misconfigured
# deploy is never an unprotected studio.
STUDIO_PASSWORD=

# Secret used to sign the studio session cookie. Any long random string;
# generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Vercel Blob read/write token, for uploading post images (including from a
# phone). Create a Blob store in the Vercel dashboard and Vercel injects this
# automatically. Without it, images can still be added by pasting a URL.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# SCHEDULED PUBLISHING — the cron that takes queued drafts live
# ---------------------------------------------------------------------------

# Bearer token Vercel Cron sends to /api/cron/publish. Generate one with:
#   openssl rand -base64 32
# If unset, /api/cron/publish returns 404 and nothing is ever auto-published —
# a misconfigured deploy is never an open publish endpoint.
CRON_SECRET=
